// Static assets only: Cloudflare serves the prebuilt dist/ folder, including its _headers and _redirects files.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ali-ahmed",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
