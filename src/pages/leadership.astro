---
import BaseLayout from "../layouts/BaseLayout.astro";
import BilingualText from "../components/BilingualText.astro";
import LinkPills from "../components/LinkPills.astro";
import PageHero from "../components/PageHero.astro";
import { communityLeadership, events, pageDescriptions } from "../data/site";
---

<BaseLayout title="Leadership" description={pageDescriptions.leadership} pageClass="page--leadership">
  <PageHero title={{ english: "Leadership", urdu: "قیادت" }} lead="Societies and events I helped run as a student at FAST-NUCES." />

  <nav class="reader-section-links" aria-label="Leadership sections">
    <a href="#events-heading">Events and competitions</a>
    <a href="#leadership-heading">Community leadership</a>
  </nav>

  <section class="section-block" aria-labelledby="leadership-heading">
    <div class="section-heading">
      <h2 id="leadership-heading"><BilingualText english="Community Leadership" urdu="کمیونٹی قیادت" /></h2>
    </div>
    <div class="community-grid">
      {
        communityLeadership.map((role) => (
          <article class="surface-card community-card">
            <h3>{role.title}</h3>
            <p class="card-meta">
              <strong>{role.role}</strong>
            </p>
            <p class="community-card__description">{role.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-block" aria-labelledby="events-heading">
    <div class="section-heading">
      <h2 id="events-heading"><BilingualText english="Events & Competitions" urdu="ایونٹس اور مقابلے" /></h2>
    </div>
    <div class="workshop-grid">
      {
        events.map((event) => (
          <article class="surface-card workshop-card">
            <h3>{event.title}</h3>
            <p class="card-meta">{event.meta}</p>
            <p class="workshop-card__description">{event.description}</p>
            <LinkPills links={event.links} variant="primary" />
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
