---
import { getBlogExport } from "../../lib/blog-export";
import { render } from "astro:content";
import defaultMdxComponents from "fumadocs-ui/mdx";
import BlogCode from "../../components/blog/BlogCode.astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import BlogVideo from "../../components/blog/BlogVideo.astro";
import "../../styles/blog-article.css";
import { personId, site } from "../../data/site";
import { formatWritingDate, getPublishedBlog, getWritingPath, type PublishedWriting } from "../../lib/blog-source";
interface Props {
  entry: PublishedWriting;
}
export async function getStaticPaths() {
  return (await getPublishedBlog()).map((entry) => ({
    params: { slug: getWritingPath(entry).slice("/blog/".length, -1) },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.map((heading) => ({ depth: heading.depth, title: heading.text, url: `#${heading.slug}` }));
const blogExport = getBlogExport(entry);
const jsonLd = [
  {
    "@type": "BlogPosting",
    "@id": `${blogExport.canonicalUrl}#article`,
    headline: entry.data.title,
    description: entry.data.description,
    url: blogExport.canonicalUrl,
    mainEntityOfPage: blogExport.canonicalUrl,
    datePublished: entry.data.publishedAt.toISOString(),
    dateModified: (entry.data.updatedAt ?? entry.data.publishedAt).toISOString(),
    author: { "@id": personId },
    publisher: { "@id": personId },
    image: new URL(site.socialImage.src, site.url).href,
    keywords: entry.data.tags.join(", "),
    wordCount: (entry.body ?? "").split(/\s+/).length,
    isPartOf: { "@id": `${site.url}/#website` },
    ...(entry.data.video && { video: { "@id": `${blogExport.canonicalUrl}#video` } }),
  },
  ...(entry.data.video
    ? [
        {
          "@type": "VideoObject",
          "@id": `${blogExport.canonicalUrl}#video`,
          name: entry.data.video.title,
          description: entry.data.video.transcript,
          thumbnailUrl: new URL(entry.data.video.poster, site.url).href,
          contentUrl: new URL(entry.data.video.src, site.url).href,
          uploadDate: entry.data.publishedAt.toISOString(),
          duration: entry.data.video.duration,
          creator: { "@id": personId },
          inLanguage: "en",
        },
      ]
    : []),
];
const readingMinutes = Math.max(1, Math.ceil((entry.body ?? "").split(/\s+/).length / 220));
---

<BlogLayout
  title={entry.data.title}
  description={entry.data.description}
  article
  {...blogExport}
  jsonLd={jsonLd}
  toc={toc}
  date={entry.data.publishedAt.toISOString()}
  dateLabel={formatWritingDate(entry.data.publishedAt)}
  updatedLabel={entry.data.updatedAt && formatWritingDate(entry.data.updatedAt)}
  readingMinutes={readingMinutes}
  tags={entry.data.tags}
>
  {entry.data.video && <BlogVideo {...entry.data.video} />}
  <Content components={{ pre: BlogCode, a: defaultMdxComponents.a, table: defaultMdxComponents.table }} />
</BlogLayout>
