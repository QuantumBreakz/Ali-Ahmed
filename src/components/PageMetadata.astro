---
import { personId, site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  canonical?: URL | string;
  markdown?: URL | string;
  llms?: URL | string;
  robots?: string;
  type?: "website" | "article";
  image?: URL | string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  /** Extra schema.org nodes for this page; the Person and WebSite nodes are always included. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  markdown,
  llms,
  robots,
  type = "website",
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  jsonLd = [],
} = Astro.props;
const canonicalUrl = canonical?.toString();
const markdownUrl = markdown?.toString();
const llmsUrl = llms?.toString();
const imageUrl = image?.toString();
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: site.fullName,
      alternateName: "QuantumBreakz",
      url: `${site.url}/`,
      image: new URL(site.socialImage.src, site.url).href,
      email: `mailto:${site.email}`,
      jobTitle: site.jobTitle,
      description: site.homeDescription,
      worksFor: { "@type": "Organization", name: site.worksFor.name, url: site.worksFor.url },
      alumniOf: { "@type": "CollegeOrUniversity", name: site.alumniOf },
      address: { "@type": "PostalAddress", addressLocality: site.location.locality, addressCountry: site.location.country },
      knowsAbout: site.knowsAbout,
      sameAs: site.sameAs,
    },
    { "@type": "WebSite", "@id": `${site.url}/#website`, url: `${site.url}/`, name: site.fullName, publisher: { "@id": personId } },
    ...jsonLd,
  ],
}).replace(/</g, "\\u003c");
---

<meta name="generator" content={Astro.generator} />
{description && <meta name="description" content={description} />}
<meta name="author" content={site.fullName} />
{robots && <meta name="robots" content={robots} />}
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#1c1c1d" media="(prefers-color-scheme: dark)" />
<meta property="og:site_name" content={site.fullName} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content={type} />
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
{description && <meta name="twitter:description" content={description} />}
{imageUrl && <meta name="twitter:image" content={imageUrl} />}
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
<link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48" />
<link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
<link rel="icon" href={site.favicon} type="image/svg+xml" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
<link rel="alternate" type="application/rss+xml" title="Blog RSS" href={new URL("/blog/rss.xml", site.url)} />
<link rel="alternate" type="application/rss+xml" title="Notes RSS" href={new URL("/notes/rss.xml", site.url)} />
{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
{markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} title={`${title} as Markdown`} />}
{llmsUrl && <link rel="alternate" type="text/plain" href={llmsUrl} title="LLM content index" />}
<title>{title}</title>
<script type="application/ld+json" is:inline set:html={structuredData} />
